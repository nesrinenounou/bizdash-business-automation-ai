# Copy to .env and replace EVERY value below.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=change-me-with-48-random-characters-minimum-xxxxxxxxxx
DB_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-12-chars-min
N8N_USER=admin
N8N_PASSWORD=change-me
# Optional: real AI. Without a key, a keyword-based fallback is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
